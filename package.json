{
    "name": "cv-server--ts",
    "private": false,
    "version": "2.1.0",
    "type": "module",
    "scripts": {
        "client:dev": "vite",
        "dev": "netlify dev",
        "build": "tsc && vite build",
        "test": "netlify dev:exec npm run vitest-all",
        "testint": "netlify dev:exec npm run vitest-integration-only",
        "vitest-all": "vitest -c ./vitest.all.config.ts",
        "vitest-integration-only": "vitest -c ./vitest.integration.config.ts",
        "vitest-unit-only": "vitest -c ./vitest.unit.config.ts"
    },
    "dependencies": {
        "@netlify/functions": "^6.1.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.5",
        "@types/node": "^26.6.6",
        "autoprefixer": "^10.6.2",
        "netlify-cli": "^27.19.0",
        "postcss": "^8.5.33",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    }
}
